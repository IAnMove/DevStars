# Required: GitHub personal access token (server-side only).
# The app uses the GitHub GraphQL API, which does not work without authentication.
GITHUB_TOKEN=

# Optional: how long GitHub data is cached in memory, in milliseconds (default 1800000 = 30 min)
# GITHUB_CACHE_TTL_MS=1800000

# Optional: path of the leaderboard SQLite file (default: <cwd>/data/leaderboard.db)
# DB_PATH=
